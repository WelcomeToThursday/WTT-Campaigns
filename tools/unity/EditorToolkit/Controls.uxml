<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Editor.uss" />
    <ui:VisualElement name="Controls" class="editor-group">
        <ui:ScrollView name="ControlsScroll" class="editor-content-scroll">
            <ui:VisualElement class="editor-card">
                <ui:Label text="EDITOR CONTROLS" class="editor-heading" picking-mode="Ignore" />
                <ui:Label name="Help" class="editor-label" text="Alt+LMB: orbit / MMB: pan / RMB + WASD: fly · Q / E: elevation&#10;Fly m/s: speed · Shift: 4× · Ctrl: precision&#10;Drag handles · Alt: bypass snap · Ctrl+Z/Y: undo/redo&#10;Drag titles or dock tabs to float, split or group tools. Drag dividers to resize docks. Shift+Space: maximize viewport. G: clean view.&#10;The left rail opens tools. Drag a floating corner to resize. Reset layout restores defaults.&#10;Escape dismisses menus, releases a field or cancels a tool. Use Session to unload the map." picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>

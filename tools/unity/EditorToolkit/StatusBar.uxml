<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Editor.uss" />
    <ui:VisualElement name="StatusBar" class="editor-toolbar editor-actions editor-action-row">
        <ui:Label name="Status" text="" class="editor-label" picking-mode="Ignore" />
        <ui:Label name="PreviewStatus" class="editor-label" picking-mode="Ignore" />
        <ui:Button name="NoticeToggle" text="Notice..." class="editor-action" />
        <ui:VisualElement name="NoticePanel" class="editor-notice-panel">
            <ui:ScrollView name="NoticeScroll" class="editor-content-scroll">
                <ui:Label name="NoticeText" class="editor-notice-text" />
            </ui:ScrollView>
            <ui:Button name="NoticeDismiss" text="Dismiss notice" class="editor-action" />
        </ui:VisualElement>
        <ui:Label name="Request" text="" class="editor-label" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>

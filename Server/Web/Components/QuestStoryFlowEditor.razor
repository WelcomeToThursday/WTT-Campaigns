@using WTT.Campaigns.Server.Web.Authoring
@using WTT.Campaigns.Shared.Story
<div class="quest-story-flow">
    <section class="editor-section"><header><h3>What happens as this quest progresses?</h3><p>Connect journal notes and conversations here. Open a linked record to write its content in its own workspace.</p></header>
    @foreach (var pair in Membership.StatusNotes)
    {
        @foreach(var id in pair.Value)
        {
            var note = Season.Story!.Notes.FirstOrDefault(n => n.Id == id);
            <article class="story-event-row" @key="@(pair.Key + "/" + id)"><div><span class="eyebrow">WHEN</span><strong>Quest is @AuthoringSummary.Status(pair.Key)</strong></div><span aria-hidden="true">→</span><div><span class="eyebrow">THEN · ADD JOURNAL NOTE</span><p>@(note?.Text ?? "Missing journal note — repair this link below")</p></div>@if (note != null) { <button @onclick="@(() => Navigate.InvokeAsync("Story/" + id))">Edit note</button> }</article>
        }
    }
    @if (!Membership.StatusNotes.Values.Any(ids => ids.Count > 0)) { <p class="authoring-empty">No journal events yet. Add a note for acceptance, completion or another quest status.</p> }
    <div class="authoring-create"><label>When this quest is<select @bind="_status">@foreach (var status in StoryRules.QuestStatuses) { <option value="@status">@AuthoringSummary.Status(status)</option> }</select></label><button @onclick="AddNote">Create and write note</button></div>
    <details class="editor-card"><summary>Link or unlink existing notes</summary><p>Choose a quest status, then add a reference to an existing journal note. Unlinking keeps the note in the campaign.</p><StoryFields Season="Season" Value="Membership" Changed="Changed" Excluded="@(new[] { "QuestId", "ChapterId", "Main", "AutoStart", "AutoComplete", "Hidden", "Visibility" })" /></details>
    </section>
    <section class="editor-section"><header><h3>Quest conversations</h3><p>Write dialogue and player replies in the conversation workspace. These links follow conversations that reference this quest.</p></header>
    @foreach (var dialog in LinkedDialogs)
    {
        <article class="linked-story-record" @key="dialog.Id"><div><span class="eyebrow">CONVERSATION · @dialog.Lines.Count LINES</span><strong>@StoryAuthoring.Label(dialog)</strong>
        @if (!ReferencesQuest(dialog)) { <p class="notice">This conversation no longer references this quest. It remains available here until you leave, and in Conversations.</p> }
        </div><button @onclick="@(() => Navigate.InvokeAsync("Story/" + dialog.Id))">Open in Conversations</button></article>
    }
    @if (!LinkedDialogs.Any()) { <p class="authoring-empty">No linked conversations. Start with a quest introduction below.</p> }
    <details class="editor-card"><summary>Create a quest introduction</summary><p>Creates an accept-quest reply, a conversation phase and a lobby entry point. Write the dialogue after creating it.</p>
        <ContentPicker Kind="traders" Label="Conversation trader" Value="@Trader" ValueChanged="@(v => _trader = v)" HelpText="Defaults to this quest's trader. The introduction and lobby entry point use this trader." />
        <label class="check"><input type="checkbox" @bind="_branching" />Include a decline reply</label>
        <button disabled="@(!SeasonValidator.IsId(Trader))" @onclick="AddConversation">Create and write conversation</button>
    </details></section>
    <details class="editor-section"><summary>Automatic quest progression</summary><p>These options control acceptance and hand-in. Native unlock requirements and completion objectives still apply.</p><StoryFields Season="Season" Value="Membership" Changed="Changed" Excluded="@(new[] { "QuestId", "ChapterId", "Main", "Hidden", "Visibility", "StatusNotes" })" /></details>
    <details class="editor-section"><summary>Journal visibility and chapter completion</summary><p>Control whether this quest appears in the story journal and counts toward chapter completion. This does not replace its native unlock requirements.</p><StoryFields Season="Season" Value="Membership" Changed="Changed" Excluded="@(new[] { "QuestId", "ChapterId", "AutoStart", "AutoComplete", "StatusNotes" })" /></details>
</div>
@code {
    [Parameter] public SeasonDefinition Season { get; set; } = null!;
    [Parameter] public NativeQuest Quest { get; set; } = null!;
    [Parameter] public StoryQuest Membership { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<string> Navigate { get; set; }
    private string _status = "Success";
    private string? _trader;
    private bool _branching = true;
    private SeasonDefinition? _dialogSeason;
    private string? _dialogQuest;
    private readonly HashSet<string> _visibleDialogs = new(StringComparer.Ordinal);
    private string Trader => _trader ?? (string?)Quest.TraderId ?? "";
    private bool ReferencesQuest(StoryDialog dialog) => ModelGraph.Texts(dialog).Any(p => p.Field == "QuestId" && p.Value == Membership.QuestId);
    private IEnumerable<StoryDialog> LinkedDialogs => Season.Story!.Dialogs.Where(d => _visibleDialogs.Contains(d.Id));
    protected override void OnParametersSet()
    {
        // A mutable quest reference discovers conversations; it must not evict an editor mid-edit.
        // This selection is local to the current draft and quest, never persisted as story data.
        if (!ReferenceEquals(_dialogSeason, Season) || _dialogQuest != Membership.QuestId)
        { _visibleDialogs.Clear(); _dialogSeason = Season; _dialogQuest = Membership.QuestId; }
        _visibleDialogs.UnionWith(Season.Story!.Dialogs.Where(ReferencesQuest).Select(d => d.Id));
    }
    private async Task AddNote() { var note = QuestStoryFlow.AddNote(Season, Membership, _status); await Changed.InvokeAsync(); await Navigate.InvokeAsync("Story/" + note.Id); }
    private async Task AddConversation() { var dialog = StoryAuthoring.AddConversation(Season, Trader, _branching, Membership.QuestId); await Changed.InvokeAsync(); await Navigate.InvokeAsync("Story/" + dialog.Id); }
}

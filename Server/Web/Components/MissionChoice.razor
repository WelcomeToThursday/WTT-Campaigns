<label>@Label<select value="@Value" @onchange="e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)">
    @if (AllowEmpty) { <option value="">@Empty</option> }
    @foreach (var choice in Choices) { <option value="@choice.Id">@choice.Name</option> }
</select></label>
@code {
    [Parameter] public bool AllowEmpty { get; set; } = true;
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Empty { get; set; } = "Choose…";
    [Parameter] public IEnumerable<(string Id, string Name)> Choices { get; set; } = [];
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
}

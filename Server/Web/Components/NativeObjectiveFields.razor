@inject SeasonContentService Content
@using WTT.Campaigns.Server.Web.Authoring
@using WTT.Campaigns.Shared.Story
<details class="editor-card objective-card" open="@Expanded" @key="Value">
<summary><span class="eyebrow">@(Nested ? "EVENT FILTER" : "SAVED RULE")</span><strong>@(Nested || string.IsNullOrWhiteSpace(Quest.Text(Value.Id)) ? AuthoringSummary.ObjectiveKind(Value.ConditionType) : Quest.Text(Value.Id))</strong><span class="objective-rule">@AuthoringSummary.Objective(Season, Value, Content.Name)</span><span class="edit-affordance">Edit rules</span></summary>
@if (StoryQuest && !StoryQuestCompatibility.Supports(Value, Nested)) { <p class="notice error">This objective is unsupported here. Counter filters must be inside a counter objective.</p> }
@if (!Nested)
{
<fieldset class="field-section"><legend>Player instruction</legend>
<label>Objective text <HelpTip Text="Player-facing instruction, for example Find two medical kits. This text does not change what the objective checks." /><input value="@Quest.Text(Value.Id)" @onchange="@(e => ChangeText(e.Value?.ToString() ?? ""))" /></label>
<label class="check"><input type="checkbox" checked="@(Value.IsNecessary != false)" @onchange="@(async e => { Value.IsNecessary = (bool)e.Value!; await Changed.InvokeAsync(); })" />Required objective <HelpTip Text="Required objectives block quest completion until satisfied. Optional objectives can remain unfinished." /></label>
</fieldset>
}
@if (Value.ConditionType == "Quest")
{ <fieldset class="field-section"><legend>Accepted prerequisite statuses</legend><p>Any selected status can satisfy the prerequisite.</p><div class="check-grid">@foreach(var status in NativeStatuses) { <label class="check"><input type="checkbox" checked="@(Value.Status?.Contains(status.Value.ToString()) == true || Value.Status?.Contains(status.Key.Replace(" ", "")) == true)" @onchange="@(e => ToggleStatus(status.Value, (bool)e.Value!))" />@status.Key <HelpTip Text="@($"The prerequisite may be {status.Key.ToLowerInvariant()}. {(status.Value == 4 ? "Success means completed and handed in." : "Select other statuses to allow alternatives.")}")" /></label> }</div></fieldset> }
@if (Value.ConditionType is "InZone" or "VisitPlace" or "LeaveItemAtLocation" or "Salvage")
{
    <label>Authored zone<select value="@WTT.Campaigns.Shared.Spatial.SpatialRules.References(Value).FirstOrDefault()" @onchange="PickZone"><option value="">Choose a zone or keep native reference</option>@foreach(var zone in Season.Zones.Where(z => z.Uses.Contains(Value.ConditionType))) { <option value="@zone.Id">@zone.Name · @zone.Location</option> }</select></label>
    <RaidCaptureButton TargetKind="Condition" TargetId="@Value.Id" /><RaidCaptureButton TargetKind="Condition" TargetId="@Value.Id" RecordId="@(WTT.Campaigns.Shared.Spatial.SpatialRules.References(Value).FirstOrDefault() ?? "")" Label="Edit in raid" />
    @if (Value.ConditionType == "Salvage")
    {
        <p>Choose a campaign salvage zone, or enter an existing CommonLib zone ID below. Configure the required item, duration and salvage rewards under Zones and captures. Salvaging completes this objective once.</p>
    }
}
<StructuredFields Value="Value" OwnedItems="OwnedItems" OwnedQuests="OwnedQuests" Changed="Changed" Excluded="@(new[] { "counter", "isNecessary" })" />
@if (Value.Counter is { } counter)
{
    <section class="editor-section"><header><h4>Qualifying raid events</h4><p>Filters belong to this counter. Combine event type, map and combat restrictions here.</p></header>
    @foreach(var child in counter.Conditions.ToArray())
    { <div class="objective-entry" @key="child"><NativeObjectiveFields Season="Season" Quest="Quest" Value="child" Nested="true" StoryQuest="StoryQuest" Changed="Changed" /><div class="record-actions"><button class="danger" @onclick="@(async () => { counter.Conditions.Remove(child); await Changed.InvokeAsync(); })">Remove filter</button></div></div> }
    <select aria-label="Add counter filter" value="" @onchange="@(e => AddFilter(counter, e.Value?.ToString() ?? ""))"><option value="">Add filter…</option>@foreach(var kind in Kinds(true, true)) { <option>@kind</option> }</select>
    </section>
}
</details>
@code {
    [Parameter] public SeasonDefinition Season { get; set; } = null!;
    [Parameter] public NativeQuest Quest { get; set; } = null!;
    [Parameter] public NativeCondition Value { get; set; } = null!;
    [Parameter] public bool StoryQuest { get; set; }
    [Parameter] public bool Nested { get; set; }
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private IEnumerable<ContentChoice> OwnedItems => StoryAuthoring.Choices(Season, "items").Select(c => new ContentChoice(c.Id, c.Name));
    private IEnumerable<ContentChoice> OwnedQuests => StoryAuthoring.Choices(Season, "quests").Select(c => new ContentChoice(c.Id, c.Name));
    private static readonly Dictionary<string, int> NativeStatuses = new() { ["Locked"] = 0, ["Available for start"] = 1, ["Started"] = 2, ["Available for finish"] = 3, ["Success"] = 4, ["Fail"] = 5, ["Fail restartable"] = 6, ["Marked as failed"] = 7, ["Expired"] = 8, ["Available after"] = 9 };
    public static IEnumerable<string> Kinds(bool story, bool nested) => NativeQuestAuthoring.ConditionKinds(story, nested);
    private async Task ChangeText(string text) { Quest.English()[Value.Id] = text; await Changed.InvokeAsync(); }
    private async Task ToggleStatus(int status, bool enabled) { Value.Status ??= new(); var code = status.ToString(); if (enabled && !Value.Status.Contains(code)) Value.Status.Add(code); else if (!enabled) Value.Status.RemoveAll(s => s == code || s.Equals(NativeStatuses.First(p => p.Value == status).Key.Replace(" ", ""), StringComparison.OrdinalIgnoreCase)); await Changed.InvokeAsync(); }
    private async Task PickZone(ChangeEventArgs e) { if (e.Value?.ToString() is { Length: > 0 } id) { WTT.Campaigns.Shared.Spatial.SpatialRules.Assign(Value, id); await Changed.InvokeAsync(); } }
    private async Task AddFilter(NativeCounter counter, string kind) { if (kind.Length == 0) return; counter.Conditions.Add(NativeQuestAuthoring.Condition(kind)); await Changed.InvokeAsync(); }
}

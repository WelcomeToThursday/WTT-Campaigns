@using System.Collections
@using System.Reflection
@using SeasonalPerks.Shared.Story
@using SeasonalPerks.Server.Web.Authoring
<div class="story-fields" data-record="@Value.GetType().Name" @key="Value">
@if (Depth > 32) { <p class="notice error">Condition nesting exceeds 32 levels. Remove this group to repair it.</p> }
else
{
    @foreach (var group in Value.GetType().GetProperties().Where(p => p.CanWrite && !Excluded.Contains(p.Name) && StoryAuthoring.Visible(Value, p.Name)).GroupBy(p => EditorFieldGuide.StoryGroup(Value, p.Name)))
    {
        <fieldset class="field-section story-section"><legend>@group.Key</legend><div class="story-section-fields">
        @foreach (var property in group)
    {
        var prop = property; var current = prop.GetValue(Value); var type = prop.PropertyType;
        <div class="story-field @FieldLayout(type, current, prop.Name)" data-field="@prop.Name" @key="prop.Name">
        @if (current is IDictionary dictionary)
        {
            <details class="editor-card" open><summary>@StoryAuthoring.Friendly(prop.Name) <HelpTip Text="@StoryAuthoring.Help(Value, prop.Name)" /></summary>
            @foreach (var key in dictionary.Keys.Cast<object>().ToArray())
            {
                var entryKey = key;
                <div class="editor-card"><strong>@key</strong>
                @if (dictionary[key] is IList values)
                {
                    @for (var i = 0; i < values.Count; i++)
                    {
                        var index = i;
                        <div class="row"><StoryValue Season="Season" Owner="Value" Field="@prop.Name" Caption="Journal note" Value="values[index]" Changed="@(v => UpdateList(values, index, v))" /><button @onclick="@(() => Remove(values, index))">Remove reference</button></div>
                    }
                    <button @onclick="@(() => Add(values, typeof(string)))">Add note reference</button>
                }
                else
                { <StoryValue Season="Season" Owner="Value" Field="@prop.Name" Caption="Phase value" Value="dictionary[key]" ValueType="typeof(int)" Changed="@(async v => { dictionary[entryKey] = v; await Changed.InvokeAsync(); })" /> }
                <button @onclick="@(async () => { dictionary.Remove(entryKey); await Changed.InvokeAsync(); })">Remove @key</button></div>
            }
            <div class="inline-fields">
            @if (Value is StoryQuest)
            { <label>Status<select @bind="_key"><option value="">Choose…</option>@foreach(var status in StoryRules.QuestStatuses) { <option>@status</option> }</select></label> }
            else { <label>New start point name<input @bind="_key" /></label> }
            <button disabled="@(_key.Length == 0 || dictionary.Contains(_key))" @onclick="@(() => AddKey(dictionary, type))">Add entry</button></div>
            </details>
        }
        else if (current is IList list)
        {
            var itemType = type.GetGenericArguments()[0];
            <details class="editor-card" open><summary>@StoryAuthoring.Friendly(prop.Name) · @list.Count <HelpTip Text="@StoryAuthoring.Help(Value, prop.Name)" /></summary>
            @for (var i = 0; i < list.Count; i++)
            {
                var index = i; var item = list[index]!;
                <div class="nested-record" @key="@(itemType == typeof(string) ? (object)index : item)">
                @if (itemType == typeof(string))
                { <StoryValue Season="Season" Owner="Value" Field="@prop.Name" Value="item" Changed="@(v => UpdateList(list, index, v))" /> }
                else
                {
                    <details open="@(item is not StoryDialogLine)"><summary>@StoryAuthoring.Label(item)</summary>
                    <StoryFields Season="Season" Value="item" Changed="Changed" Depth="@(Depth + 1)" />
                    </details>
                }
                <div class="row record-actions"><button disabled="@(index == 0)" @onclick="@(() => Move(list, index, -1))" aria-label="Move earlier">↑</button><button disabled="@(index == list.Count - 1)" @onclick="@(() => Move(list, index, 1))" aria-label="Move later">↓</button>
                @if (itemType != typeof(string)) { <button @onclick="@(async () => { list.Insert(index + 1, StoryAuthoring.Duplicate(item)); await Changed.InvokeAsync(); })">Duplicate</button> }
                <button class="danger" @onclick="@(() => Remove(list, index))">Remove</button></div>
                </div>
            }
            <button disabled="@(Value is StoryCondition { Type: "Not" } && list.Count > 0)" @onclick="@(() => Add(list, itemType))">Add @Singular(prop.Name)</button>
            </details>
        }
        else if (type.Namespace == typeof(StoryDefinition).Namespace && !type.IsEnum)
        {
            <details class="editor-card" open="@(prop.Name is "Visibility" or "Trigger" or "Condition")"><summary>@StoryAuthoring.Friendly(prop.Name) <HelpTip Text="@StoryAuthoring.Help(Value, prop.Name)" /></summary>
            @if (current != null)
            {
                <StoryFields Season="Season" Value="current" Changed="Changed" Depth="@(Depth + 1)" />
                @if (prop.Name == "Random") { <button @onclick="@(() => Set(prop, null))">Remove random gate</button> }
            }
            else { <button @onclick="@(() => Set(prop, StoryAuthoring.Create(type)))">Configure @StoryAuthoring.Friendly(prop.Name)</button> }
            </details>
        }
        else
        { <StoryValue Season="Season" Owner="Value" Field="@prop.Name" Value="current" ValueType="type" Changed="@(v => Set(prop, v))" /> }
        </div>
    }
    </div></fieldset>
    }
}
@if (_message.Length > 0) { <div class="notice error" role="alert">@_message</div> }
</div>
@code {
    [Parameter, EditorRequired] public object Value { get; set; } = null!;
    [Parameter, EditorRequired] public SeasonDefinition Season { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public int Depth { get; set; }
    [Parameter] public IEnumerable<string> Excluded { get; set; } = [];
    private string _key = "", _message = "";
    private static string FieldLayout(Type type, object? value, string name) => value is IDictionary or IList || type.Namespace == typeof(StoryDefinition).Namespace && !type.IsEnum ? "field-group" : type == typeof(bool) ? "field-check" : type != typeof(string) && !type.IsEnum ? "field-number" : name is "Text" or "Confirmation" ? "field-prose" : name is "Image" or "Icon" ? "field-artwork" : "field-standard";
    private static string Singular(string name) => name switch { "Lines" => "line", "Actions" => "action", "Conditions" => "condition", "ConditionIds" => "objective reference", "Status" => "status", _ => "entry" };
    private async Task Set(PropertyInfo prop, object? value)
    {
        prop.SetValue(Value, value);
        if (Value is StoryCondition c && prop.Name == "Type")
        { c.Conditions.Clear(); c.Target = ""; c.Status.Clear(); }
        if (Value is StoryAction a)
        {
            if (prop.Name == "Type") { a.Target = ""; a.QuestId = ""; a.ConditionId = ""; }
            if (a.Type == StoryActionType.SetVariable && prop.Name == "Target" && Season.Story?.Variables.FirstOrDefault(v => v.Id == a.Target) is { } variable) a.Scope = variable.Scope;
        }
        await Changed.InvokeAsync();
    }
    private async Task Add(IList list, Type type) { list.Add(type == typeof(string) ? "" : StoryAuthoring.Create(type)); await Changed.InvokeAsync(); }
    private async Task UpdateList(IList list, int index, object value) { list[index] = value; await Changed.InvokeAsync(); }
    private async Task Remove(IList list, int index)
    {
        var uses = list[index] is string ? [] : StoryAuthoring.Uses(Season, list[index]!);
        if (uses.Count > 0) { _message = "Remove or reassign these references first: " + string.Join(", ", uses); return; }
        list.RemoveAt(index); _message = ""; await Changed.InvokeAsync();
    }
    private async Task Move(IList list, int index, int direction) { var item = list[index]; list.RemoveAt(index); list.Insert(index + direction, item); await Changed.InvokeAsync(); }
    private async Task AddKey(IDictionary dictionary, Type type)
    {
        if (_key.Length == 0 || dictionary.Contains(_key)) return;
        dictionary.Add(_key, type.GetGenericArguments()[1] == typeof(int) ? 0 : new List<string>()); _key = ""; await Changed.InvokeAsync();
    }
}

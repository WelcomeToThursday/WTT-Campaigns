@using SeasonalPerks.Server.Web.Authoring
@foreach (var group in Value.Properties().Where(p => !Hidden.Contains(p.Name) && !Excluded.Contains(p.Name) && !(p.Name == "target" && Value["items"] != null)).GroupBy(p => EditorFieldGuide.NativeGroup(p.Name)))
{
<fieldset class="field-section"><legend>@group.Key</legend><div class="structured-grid">
@foreach (var property in group)
{
    var field = property;
    @if (Hidden.Contains(field.Name) || Excluded.Contains(field.Name) || field.Name == "target" && Value["items"] != null) { continue; }
    <div class="structured-field @(field.Value is JObject or JArray ? "field-wide" : "")" @key="field.Name">
        @if (field.Value is JObject child)
        {
            <details class="nested-settings"><summary>@Friendly(field.Name) <HelpTip Text="@FieldHelp(field.Name)" /></summary><StructuredFields Value="child" Changed="Changed" OwnedItems="OwnedItems" OwnedQuests="OwnedQuests" /></details>
        }
        else if (field.Value is JArray list)
        {
            <label>@Friendly(field.Name) <HelpTip Text="@FieldHelp(field.Name)" /></label>
            @foreach (var token in list.ToArray())
            {
                var entry = token;
                <div class="array-entry">
                    @if (entry is JObject obj) { <details class="nested-settings" open><summary>@EditorFieldGuide.NativeTitle(EditorFieldGuide.NativeKind(obj)) · entry @(list.IndexOf(entry) + 1)</summary><StructuredFields Value="obj" Changed="Changed" OwnedItems="OwnedItems" OwnedQuests="OwnedQuests" /></details> }
                    else if (ChoiceKind(field.Name) is { } kind)
                    { <ContentPicker Kind="@kind" Label="@Friendly(field.Name)" HelpText="@FieldHelp(field.Name)" Value="@entry.ToString()" ValueChanged="@(v => SetArray(entry, v))" Additional="Additional(kind)" /> }
                    else { <input aria-label="@Friendly(field.Name)" value="@entry.ToString()" @onchange="@(e => SetArray(entry, e.Value?.ToString() ?? string.Empty))" /> }
                    <button type="button" class="subtle" @onclick="@(() => Remove(entry))">Remove</button>
                </div>
            }
            <button type="button" class="subtle" @onclick="@(() => Add(list, field.Name))">Add @Friendly(field.Name)</button>
        }
        else if (field.Name == "compareMethod") { <label>Comparison <HelpTip Text="@FieldHelp(field.Name)" /><select value="@field.Value.ToString()" @onchange="@(e => Set(field, e.Value?.ToString() ?? ">="))">@foreach (var op in SeasonalPerks.Shared.Story.StoryRules.Operators) { <option>@op</option> }</select></label> }
        else if (field.Value.Type == JTokenType.Boolean)
        { <label class="check"><input type="checkbox" checked="@((bool)field.Value)" @onchange="@(e => Set(field, (bool)e.Value!))" />@Friendly(field.Name) <HelpTip Text="@FieldHelp(field.Name)" /></label> }
        else if (field.Value.Type is JTokenType.Integer or JTokenType.Float)
        { <label>@Friendly(field.Name) <HelpTip Text="@FieldHelp(field.Name)" /><input type="number" step="any" value="@field.Value.ToString()" @onchange="@(e => Number(field, e.Value?.ToString()))" /></label> }
        else if (ChoiceKind(field.Name) is { } kind)
        { <ContentPicker Kind="@kind" Label="@Friendly(field.Name)" HelpText="@FieldHelp(field.Name)" Value="@field.Value.ToString()" ValueChanged="@(v => Set(field, v))" Additional="Additional(kind)" /> }
        else if (field.Name == "field") { <label>Filter by <HelpTip Text="@FieldHelp(field.Name)" /><select value="@field.Value.ToString()" @onchange="@(e => Set(field, e.Value?.ToString() ?? string.Empty))"><option value="_tpl">Item</option><option value="ParentId">Category</option></select></label> }
        else { <label>@Friendly(field.Name) <HelpTip Text="@FieldHelp(field.Name)" /><input value="@field.Value.ToString()" @onchange="@(e => Set(field, e.Value?.ToString() ?? string.Empty))" /></label> }
    </div>
}
</div></fieldset>
}
@code {
    [Parameter] public JObject Value { get; set; } = new();
    [Parameter] public IEnumerable<string> Excluded { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public IEnumerable<ContentChoice> OwnedItems { get; set; } = [];
    [Parameter] public IEnumerable<ContentChoice> OwnedQuests { get; set; } = [];
    private IEnumerable<ContentChoice> Additional(string kind) => kind == "items" ? OwnedItems : kind == "quests" ? OwnedQuests : [];
    private static readonly HashSet<string> Hidden = new() { "effectId", "id", "_id", "conditionType", "index", "parentId", "dynamicLocale", "visibilityConditions", "status", "type" };
    private string FieldHelp(string name) => EditorFieldGuide.NativeHelp(Value, name);
    private string Friendly(string name) => EditorFieldGuide.NativeLabel(Value, name);
    private string? ChoiceKind(string field) => field switch
    {
        "skillIds" => "skills", "traderIds" or "traderId" => "traders", "_tpl" => "items",
        "target" when (string?)Value["type"] is "TraderStanding" or "TraderUnlock" => "traders",
        "target" when (string?)Value["type"] == "Skill" => "skills",
        "target" when (string?)Value["conditionType"] == "Quest" => "quests",
        "target" when (string?)Value["conditionType"] is "TraderLoyalty" or "TraderStanding" => "traders",
        "target" when (string?)Value["conditionType"] is "FindItem" or "HandoverItem" or "HasItem" or "LeaveItemAtLocation" or "UseItem" => "items",
        "value" when (string?)Value["field"] == "_tpl" => "items",
        "value" when (string?)Value["field"] == "ParentId" => "categories",
        _ => null
    };
    private async Task Set(JProperty property, object value) { property.Value = JToken.FromObject(value); await Changed.InvokeAsync(); }
    private Task Number(JProperty property, string? value) => double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var number) && double.IsFinite(number) ? Set(property, property.Value.Type == JTokenType.Integer ? (object)(long)number : number) : Task.CompletedTask;
    private async Task SetArray(JToken token, string value) { token.Replace(token.Type == JTokenType.Integer && long.TryParse(value, out var n) ? new JValue(n) : token.Type == JTokenType.Float && double.TryParse(value, out var d) ? new JValue(d) : new JValue(value)); await Changed.InvokeAsync(); }
    private async Task Remove(JToken token) { token.Remove(); await Changed.InvokeAsync(); }
    private async Task Add(JArray array, string name) { array.Add(array.Last?.DeepClone() ?? (name is "include" or "exclude" ? new JObject { ["field"] = "_tpl", ["value"] = "" } : new JValue(""))); await Changed.InvokeAsync(); }
}

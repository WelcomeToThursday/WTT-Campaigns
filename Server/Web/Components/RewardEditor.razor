@inject SeasonContentService Content
<section class="editor-section"><header><h3>Presentation and availability</h3><p>Player-facing text, artwork and faction eligibility.</p></header><div class="form-grid">
    <label>Name<input @bind="Reward.Name" /></label>
    <label>Display kind <HelpTip Text="A presentation label for the tile, such as ITEM. The payload type determines what is actually granted." /><input @bind="Reward.Kind" /></label>
    <label>Description<textarea @bind="Reward.Description"></textarea></label>
    <label>Faction <HelpTip Text="Limits eligibility to USEC or BEAR. Both allows either faction." /><select @bind="Reward.Side"><option value="">Both</option><option>USEC</option><option>BEAR</option></select></label>
    <label class="check"><input type="checkbox" @bind="Reward.Enabled" />Enabled</label>
    <AssetPicker Label="Thumbnail" @bind-Value="Reward.Image" ArtAssets="ArtAssets" />
    <AssetPicker Label="Full artwork" @bind-Value="Reward.BigImage" ArtAssets="ArtAssets" />
</div></section><details class="editor-section"><summary>Tile placement · @Columns columns × @Rows rows</summary><div class="form-grid">
    <label>Column (zero based) <HelpTip Text="@($"Horizontal position on this {Columns}-column grid: 0 through {Math.Max(0, Columns - Reward.Width)} for the selected width. You can also drag the tile.")" /><input type="number" min="0" @bind="Reward.X" /></label>
    <label>Row (zero based) <HelpTip Text="@($"Vertical position on this {Rows}-row grid: 0 through {Math.Max(0, Rows - Reward.Height)} for the selected height.")" /><input type="number" min="0" @bind="Reward.Y" /></label>
    <label>Width <HelpTip Text="@($"Width in cells on this {Columns}-column grid. At column {Reward.X}, at most {Math.Max(1, Columns - Reward.X)} cells fit.")" /><input type="number" min="1" @bind="Reward.Width" /></label>
    <label>Height <HelpTip Text="@($"Height in cells on this {Rows}-row grid. At row {Reward.Y}, at most {Math.Max(1, Rows - Reward.Y)} cells fit.")" /><input type="number" min="1" @bind="Reward.Height" /></label>
</div>
</details><section class="editor-section"><h3>Document costs <HelpTip Text="Documents are consumed when this reward is claimed. Classified documents can cover a shortage after player confirmation. No costs makes the reward free." /></h3>
@foreach (var cost in Reward.Costs.ToArray())
{
    <div class="inline-fields"><select aria-label="Cost document" @bind="cost.DocumentId"><option value="">Choose document</option>@foreach (var doc in Documents) { <option value="@doc.Id">@doc.Name</option> }</select><input aria-label="Cost quantity" type="number" min="1" @bind="cost.Count" /><button @onclick="@(() => Reward.Costs.Remove(cost))">Remove</button></div>
}
<button class="subtle" @onclick="@(() => Reward.Costs.Add(new() { DocumentId = Documents.FirstOrDefault()?.Id ?? string.Empty, Count = 1 }))">Add cost</button>
</section><section class="editor-section"><h3>Reward contents <HelpTip Text="Every payload is granted together in one claim. Tarcoins are local currency; trader unlocks make an offer available rather than granting its items." /></h3>
@foreach (var grant in Reward.Grants.ToArray())
{
    <div class="editor-card"><div class="row"><strong>@grant.Type</strong><button @onclick="@(() => Reward.Grants.Remove(grant))">Remove payload</button></div>
    @if ((string?)grant.Type == "Tarcoin") { <label>Amount<input type="number" min="1" value="@grant.Value" @onchange="@(e => grant.Value = int.TryParse(e.Value?.ToString(), out var n) ? n : 1)" /></label> }
    else if ((string?)grant.Type == "CustomizationDirect") { <ContentPicker Kind="customizations" Label="Customization" Value="@((string?)grant.Target ?? string.Empty)" ValueChanged="@(v => grant.Target = v)" /> }
    else if ((string?)grant.Type == "AssortmentUnlock") {
        <ContentPicker Kind="offers" Label="Trader offer" Value="@((string?)grant.TraderId + "/" + (string?)grant.Target)" ValueChanged="@(v => ReplaceOffer(grant, v))" Additional="@(TraderOffers.Select(o => new ContentChoice(o.TraderId + "/" + o.Id, o.Name + " · Campaign offer")))" />
        @if (TraderOffers.Any(o => o.Id == grant.Target)) { <button @onclick="@(() => OpenOffer.InvokeAsync(grant.Target!))">Edit campaign offer</button> }
    }
    else if (grant.Items is { } items)
    {
        @foreach (var item in items)
        {
            <ContentPicker Kind="items" Label="Reward item" Value="@((string?)item.Template ?? string.Empty)" ValueChanged="@(v => item.Template = v)" Additional="OwnedItems" />
            <label>Quantity<input type="number" min="1" value="@item.Upd?.StackObjectsCount" @onchange="@(e => (item.Upd ??= new()).StackObjectsCount = int.TryParse(e.Value?.ToString(), out var n) ? n : 1)" /></label>
        }
    }
    </div>
}
<div class="inline-fields"><select aria-label="Payload type" @bind="_grantKind"><option>Item</option><option>Tarcoin</option><option>CustomizationDirect</option><option>AssortmentUnlock</option></select><button @onclick="AddGrant">Add payload</button></div>
</section><section class="editor-section"><h3>Requirements <HelpTip Text="All listed requirements must be met, along with the page gate, faction restriction and document cost." /></h3>
@foreach (var condition in Reward.Conditions.ToArray())
{
    <div class="editor-card">
        @if ((string?)condition.ConditionType == "Level") { <label>Minimum level<input type="number" min="1" value="@condition.Value" @onchange="@(e => condition.Value = int.TryParse(e.Value?.ToString(), out var n) ? n : 1)" /></label> }
        else { <ContentPicker Kind="quests" Label="Completed quest" Value="@((string?)condition.Target ?? string.Empty)" ValueChanged="@(v => condition.Target = v)" Additional="OwnedQuests" /> }
        <button @onclick="@(() => Reward.Conditions.Remove(condition))">Remove requirement</button>
    </div>
}
<div class="row"><button @onclick="AddLevel">Add level requirement</button><button @onclick="AddQuest">Add quest requirement</button></div>
</section>
@code {
    private void AddLevel() => Reward.Conditions.Add(new NativeCondition { ConditionType = "Level", Value = 1, CompareMethod = ">=" });
    private void AddQuest() => Reward.Conditions.Add(new NativeCondition { ConditionType = "Quest", Target = "" });
    [Parameter, EditorRequired] public SeasonReward Reward { get; set; } = new();
    [Parameter] public int Columns { get; set; } = 5;
    [Parameter] public int Rows { get; set; } = 2;
    [Parameter] public List<SeasonDocument> Documents { get; set; } = [];
    [Parameter] public IEnumerable<string> ArtAssets { get; set; } = [];
    [Parameter] public IEnumerable<ContentChoice> OwnedItems { get; set; } = [];
    [Parameter] public IEnumerable<ContentChoice> OwnedQuests { get; set; } = [];
    [Parameter] public List<CampaignTraderOffer> TraderOffers { get; set; } = [];
    [Parameter] public EventCallback<string> OpenOffer { get; set; }
    private string _grantKind = "Item";
    private void ReplaceOffer(NativeReward grant, string value) { if (!string.IsNullOrEmpty(value)) Reward.Grants[Reward.Grants.IndexOf(grant)] = TraderOffers.FirstOrDefault(o => o.TraderId + "/" + o.Id == value)?.Reference() ?? Content.Offer(value); }
    private void AddGrant()
    {
        var grant = WTT.Campaigns.Server.Web.Authoring.NativeQuestAuthoring.Reward(_grantKind);
        if (_grantKind == "Tarcoin") grant.Value = 50;
        Reward.Grants.Add(grant);
    }
}

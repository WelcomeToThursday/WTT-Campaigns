@inject SeasonContentService Content
<div class="form-grid">
    <label>Name<input @bind="Reward.Name" /></label>
    <label>Display kind <HelpTip Text="A presentation label for the tile, such as ITEM. The payload type determines what is actually granted." /><input @bind="Reward.Kind" /></label>
    <label>Description<textarea @bind="Reward.Description"></textarea></label>
    <label>Faction <HelpTip Text="Limits eligibility to USEC or BEAR. Both allows either faction." /><select @bind="Reward.Side"><option value="">Both</option><option>USEC</option><option>BEAR</option></select></label>
    <label class="check"><input type="checkbox" @bind="Reward.Enabled" />Enabled</label>
    <AssetPicker Label="Thumbnail" @bind-Value="Reward.Image" ArtAssets="ArtAssets" />
    <AssetPicker Label="Full artwork" @bind-Value="Reward.BigImage" ArtAssets="ArtAssets" />
    <label>Column (zero based) <HelpTip Text="Horizontal position, starting at zero on the left. You can also move the tile by dragging it." /><input type="number" min="0" @bind="Reward.X" /></label>
    <label>Row (zero based) <HelpTip Text="Vertical position, starting at zero at the top." /><input type="number" min="0" @bind="Reward.Y" /></label>
    <label>Width <HelpTip Text="Horizontal size in grid cells. Battle pass pages have two columns; seasonal rewards have five." /><input type="number" min="1" @bind="Reward.Width" /></label>
    <label>Height <HelpTip Text="Vertical size in grid cells. Battle pass pages have three rows; seasonal rewards have two." /><input type="number" min="1" @bind="Reward.Height" /></label>
</div>
<h3>Document costs <HelpTip Text="Documents are consumed when this reward is claimed. Classified documents can cover a shortage after player confirmation. No costs makes the reward free." /></h3>
@foreach (var cost in Reward.Costs.ToArray())
{
    <div class="inline-fields"><select aria-label="Cost document" @bind="cost.DocumentId"><option value="">Choose document</option>@foreach (var doc in Documents) { <option value="@doc.Id">@doc.Name</option> }</select><input aria-label="Cost quantity" type="number" min="1" @bind="cost.Count" /><button @onclick="@(() => Reward.Costs.Remove(cost))">Remove</button></div>
}
<button class="subtle" @onclick="@(() => Reward.Costs.Add(new() { DocumentId = Documents.FirstOrDefault()?.Id ?? string.Empty, Count = 1 }))">Add cost</button>
<h3>Reward contents <HelpTip Text="Every payload is granted together in one claim. Tarcoins are local currency; trader unlocks make an offer available rather than granting its items." /></h3>
@foreach (var grant in Reward.Grants.OfType<JObject>().ToArray())
{
    <div class="editor-card"><div class="row"><strong>@grant["type"]</strong><button @onclick="@(() => grant.Remove())">Remove payload</button></div>
    @if ((string?)grant["type"] == "Tarcoin") { <label>Amount<input type="number" min="1" value="@grant["value"]" @onchange="@(e => grant["value"] = int.TryParse(e.Value?.ToString(), out var n) ? n : 1)" /></label> }
    else if ((string?)grant["type"] == "CustomizationDirect") { <ContentPicker Kind="customizations" Label="Customization" Value="@((string?)grant["target"] ?? string.Empty)" ValueChanged="@(v => grant["target"] = v)" /> }
    else if ((string?)grant["type"] == "AssortmentUnlock") { <ContentPicker Kind="offers" Label="Trader offer" Value="@((string?)grant["traderId"] + "/" + (string?)grant["target"])" ValueChanged="@(v => ReplaceOffer(grant, v))" /> }
    else if (grant["items"] is JArray items)
    {
        @foreach (var item in items.OfType<JObject>())
        {
            <ContentPicker Kind="items" Label="Reward item" Value="@((string?)item["_tpl"] ?? string.Empty)" ValueChanged="@(v => item["_tpl"] = v)" Additional="OwnedItems" />
            <label>Quantity<input type="number" min="1" value="@item["upd"]?["StackObjectsCount"]" @onchange="@(e => item["upd"]!["StackObjectsCount"] = int.TryParse(e.Value?.ToString(), out var n) ? n : 1)" /></label>
        }
    }
    </div>
}
<div class="inline-fields"><select aria-label="Payload type" @bind="_grantKind"><option>Item</option><option>Tarcoin</option><option>CustomizationDirect</option><option>AssortmentUnlock</option></select><button @onclick="AddGrant">Add payload</button></div>
<h3>Requirements <HelpTip Text="All listed requirements must be met, along with the page gate, faction restriction and document cost." /></h3>
@foreach (var condition in Reward.Conditions.OfType<JObject>().ToArray())
{
    <div class="editor-card">
        @if ((string?)condition["conditionType"] == "Level") { <label>Minimum level<input type="number" min="1" value="@condition["value"]" @onchange="@(e => condition["value"] = int.TryParse(e.Value?.ToString(), out var n) ? n : 1)" /></label> }
        else { <ContentPicker Kind="quests" Label="Completed quest" Value="@((string?)condition["target"] ?? string.Empty)" ValueChanged="@(v => condition["target"] = v)" Additional="OwnedQuests" /> }
        <button @onclick="@(() => condition.Remove())">Remove requirement</button>
    </div>
}
<div class="row"><button @onclick="AddLevel">Add level requirement</button><button @onclick="AddQuest">Add quest requirement</button></div>
@code {
    private void AddLevel() => Reward.Conditions.Add(new JObject { ["conditionType"] = "Level", ["value"] = 1, ["compareMethod"] = ">=" });
    private void AddQuest() => Reward.Conditions.Add(new JObject { ["conditionType"] = "Quest", ["target"] = "" });
    [Parameter, EditorRequired] public SeasonReward Reward { get; set; } = new();
    [Parameter] public List<SeasonDocument> Documents { get; set; } = [];
    [Parameter] public IEnumerable<string> ArtAssets { get; set; } = [];
    [Parameter] public IEnumerable<ContentChoice> OwnedItems { get; set; } = [];
    [Parameter] public IEnumerable<ContentChoice> OwnedQuests { get; set; } = [];
    private string _grantKind = "Item";
    private void ReplaceOffer(JObject grant, string value) { if (!string.IsNullOrEmpty(value)) grant.Replace(Content.Offer(value)); }
    private void AddGrant()
    {
        var grant = new JObject { ["id"] = SeasonRepository.NewId(), ["type"] = _grantKind };
        if (_grantKind == "Item") { var id = SeasonRepository.NewId(); grant["target"] = id; grant["items"] = new JArray(new JObject { ["_id"] = id, ["_tpl"] = "", ["upd"] = new JObject { ["StackObjectsCount"] = 1 } }); }
        else if (_grantKind == "Tarcoin") grant["value"] = 50;
        else grant["target"] = "";
        Reward.Grants.Add(grant);
    }
}

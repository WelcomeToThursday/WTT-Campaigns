@using WTT.Campaigns.Server.Web.Authoring
<section class="creator-handbook" aria-labelledby="creator-help-title" @oninput:stopPropagation @onchange:stopPropagation>
    <div class="guide-heading"><div><span class="eyebrow">AUTHOR'S GUIDE</span><h2 id="creator-help-title">Help and tutorials</h2><p>Learn the workspace, follow a walkthrough, or find instructions for a specific section.</p></div><button class="subtle" @onclick="Close">Close help</button></div>
    <div class="guide-tracks">
        <article><h3>Campaign basics</h3><p>Create a draft, set up starting items and documents, build a reward, then validate and export.</p><button @onclick="@(() => StartTutorial.InvokeAsync("basics"))">Start campaign basics</button></article>
        <article><h3>Your first story quest</h3><p>Connect a chapter, supply quest, journal note and trader conversation, then try the complete loop in rehearsal.</p><button class="primary" @onclick="@(() => StartTutorial.InvokeAsync("story"))">Start story tutorial</button></article>
    </div>
    <p class="guide-note">Tutorials provide directions and section links. You choose the edits and when to save. Opening help or advancing a step never creates content, publishes a pack or changes player progress.</p>
    <p class="guide-note"><a class="button subtle" href="/wtt-campaigns/docs/season-creator">Open the complete Campaign Creator documentation</a></p>
    <label>Find instructions<input @bind="_search" @bind:event="oninput" placeholder="Try handover, artwork, variables or publishing…" /></label>
    <div class="guide-topics">
        @foreach (var topic in Topics)
        {
            <details class="guide-topic"><summary>@CreatorGuidance.SectionTitle(topic.Section) <span>@topic.Purpose</span></summary>
                <ol>@foreach(var instruction in topic.Instructions) { <li>@instruction</li> }</ol>
                <p class="guide-tip">@topic.Tip</p>
                <button disabled="@(!HasDraft)" @onclick="@(() => Navigate.InvokeAsync(topic.Section))">Open @CreatorGuidance.SectionTitle(topic.Section)</button>
            </details>
        }
    </div>
    @if (!Topics.Any()) { <p role="status">No matching instructions. Try a shorter search, or clear it to see every section.</p> }
    @if (!HasDraft) { <p>Create or open a draft in the library to use the section links.</p> }
    <details class="guide-topic"><summary>Common terms</summary><dl class="guide-glossary">
        <dt>Draft</dt><dd>Your editable work. Save changes keeps it without affecting published packs or characters.</dd>
        <dt>Published pack</dt><dd>A numbered release you can export. Edit campaign resumes its working draft; publish an update and restart SPT to use it with existing characters.</dd>
        <dt>Owned quest</dt><dd>A native quest authored in this campaign. Story actions can change owned story quests; installed prerequisites remain read-only.</dd>
        <dt>Condition / trigger</dt><dd>A rule that must pass. All means every child, Any means at least one, and Not reverses exactly one child. Empty All always passes.</dd>
        <dt>Action</dt><dd>A change performed after a line or event runs. Actions execute in their listed order.</dd>
        <dt>Phase variable</dt><dd>An integer used to track a conversation's current stage, such as 0 for the greeting and 1 for the first choices.</dd>
        <dt>Entry point</dt><dd>The connection that makes a conversation available in a trader visit or raid interaction.</dd>
        <dt>Rehearsal</dt><dd>A simulation using a copied draft. It does not open player profiles or grant real rewards.</dd>
    </dl></details>
</section>
@code {
    [Parameter] public bool HasDraft { get; set; }
    [Parameter] public EventCallback<string> Navigate { get; set; }
    [Parameter] public EventCallback<string> StartTutorial { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    private string _search = "";
    private IEnumerable<CreatorHelpTopic> Topics => CreatorGuidance.Topics.Where(t => string.IsNullOrWhiteSpace(_search) || (CreatorGuidance.SectionTitle(t.Section) + " " + t.Purpose + " " + string.Join(" ", t.Instructions) + " " + t.Tip).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
}

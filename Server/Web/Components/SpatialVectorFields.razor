@using SeasonalPerks.Shared.Spatial
<fieldset class="field-section"><legend>@Label</legend><div class="row"><label>X<input type="number" step="0.05" @bind="Value.X" @bind:after="Change" /></label><label>Y<input type="number" step="0.05" @bind="Value.Y" @bind:after="Change" /></label><label>Z<input type="number" step="0.05" @bind="Value.Z" @bind:after="Change" /></label></div></fieldset>
@code {
    [Parameter] public SpatialVector Value { get; set; } = null!;
    [Parameter] public string Label { get; set; } = "Position";
    [Parameter] public EventCallback Changed { get; set; }
    private Task Change() => Changed.InvokeAsync();
}

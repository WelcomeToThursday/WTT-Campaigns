@using WTT.Campaigns.Server.Web.Authoring
@using WTT.Campaigns.Shared.Authoring
@implements IDisposable
@inject RaidAuthoringService Authoring
<section class="connected-raid" aria-label="Raid connector">
    <details class="raid-connection-details">
        <summary class="raid-connection-summary">
            <span class="raid-connection-title"><span class="raid-connection-dot @(Connected ? "is-connected" : "")" aria-hidden="true"></span>Raid connector</span>
            <span class="raid-connection-state">@(Connected ? "Connected" : _clients.Count > 0 ? "Raid available" : "Not connected")</span>
            <span class="raid-connection-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="raid-connection-body">
            <div class="raid-connection-controls">
                <select aria-label="Available raids" @bind="_client"><option value="">@(_clients.Count == 0 ? "No active raids" : "Choose a raid…")</option>@foreach (var c in _clients) { <option value="@c.Id">@c.Location · @c.CharacterId · @(c.DraftId == Draft.Id ? "Connected to this draft" : "Available")</option> }</select>
                <button disabled="@(_client.Length == 0)" @onclick="Connect">Connect draft</button>
                @if (Connected) { <button class="subtle" @onclick="Disconnect">Disconnect</button> }
            </div>
            <details class="raid-connection-help">
                <summary>How to connect</summary>
                <p>Choose Editor in the game menu and select this draft to connect an editor map automatically. For ordinary raid captures, enable authoring in WTT-Campaigns settings, enter a raid, then choose it here. Draft edits synchronize; publish when you're ready. Use Ctrl+F8 to open the editor in the raid.</p>
            </details>
            @foreach (var c in _clients.Where(c => c.DraftId == Draft.Id))
            {
                <p class="raid-connection-session">@Draft.Definition.Name · @c.Location · Revision @Draft.Revision · Last contact @c.LastSeen.ToLocalTime().ToString("T")</p>
                @foreach (var task in c.Tasks) { <span class="small-tag">@task.Tool · @task.Status · @task.TargetId</span> }
            }
            @if (!string.IsNullOrWhiteSpace(Status) || !string.IsNullOrWhiteSpace(_message))
            {
                <p class="raid-connection-feedback" role="status">@Status @_message</p>
            }
        </div>
    </details>
</section>
@code {
    [Parameter] public DraftEnvelope Draft { get; set; } = null!;
    [Parameter] public string Status { get; set; } = "";
    [Parameter] public EventCallback Synchronize { get; set; }
    [Parameter] public EventCallback Flush { get; set; }
    private List<AuthoringClient> _clients = new();
    private string _client = "", _message = "";
    private bool Connected => _clients.Any(c => c.DraftId == Draft.Id);
    private readonly CancellationTokenSource _stop = new();
    protected override void OnInitialized() { _clients = Authoring.Clients(); _ = Refresh(); }
    private async Task Refresh()
    {
        try { while (!_stop.IsCancellationRequested) { await Task.Delay(1000, _stop.Token); await InvokeAsync(async () => { _clients = Authoring.Clients(); await Synchronize.InvokeAsync(); StateHasChanged(); }); } }
        catch (OperationCanceledException) { }
    }
    private async Task Connect() { try { await Flush.InvokeAsync(); Authoring.Connect(_client, Draft.Id); _message = "Connected. Use Ctrl+F8 in the raid."; } catch (Exception e) { _message = e.Message; } }
    private void Disconnect() { foreach (var c in Authoring.Clients().Where(c => c.DraftId == Draft.Id)) Authoring.Disconnect(c.Id); }
    public void Dispose() { _stop.Cancel(); _stop.Dispose(); }
}

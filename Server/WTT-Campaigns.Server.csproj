<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>WTT.Campaigns.Server</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\WTT-Campaigns.Shared.csproj" />
    <EmbeddedResource Include="..\data\kord-copy.json" LogicalName="WTT.Campaigns.KordCopy.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SPTushonka.Server.Core" Version="$(SptPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Server.Web" Version="$(SptPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SPTushonka.Reflection" Version="$(SptPackageVersion)" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\data\**\*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\wiki\*.md" LogicalName="WTT.Campaigns.Wiki.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\README.md" LogicalName="WTT.Campaigns.Wiki.installation.md" />
    <EmbeddedResource Include="..\RELEASE_NOTES.md" LogicalName="WTT.Campaigns.Wiki.release-notes.md" />
    <EmbeddedResource Include="..\CONTRIBUTING.md" LogicalName="WTT.Campaigns.Wiki.contributing.md" />
    <EmbeddedResource Include="..\THIRD_PARTY_NOTICES.md" LogicalName="WTT.Campaigns.Wiki.third-party-notices.md" />
    <EmbeddedResource Include="..\contributing\*.md" LogicalName="WTT.Campaigns.Wiki.contributor-%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Client\Resources\README.md" LogicalName="WTT.Campaigns.Wiki.local-ui-resources.md" />
    <EmbeddedResource Include="..\wiki\examples\story-introduction.json" LogicalName="WTT.Campaigns.Wiki.example-story-introduction.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(CampaignsAssetsDir)Icons\*.png" Link="icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(CampaignsAssetsDir)HubImages\*.png" Link="hub-images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SeasonalPerks.Client</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.5.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="spt-reflection" HintPath="$(TarkovDir)BepInEx\plugins\spt\spt-reflection.dll" Private="false" />
    <ProjectReference Include="..\Shared\WTT-Seasonal.Shared.csproj" />
    <ProjectReference Include="..\UI\WTT-Seasonal.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Sirenix.Serialization" HintPath="$(ManagedDir)Sirenix.Serialization.dll" Private="false" />
    <Reference
      Include="Assembly-CSharp"
      HintPath="$(TarkovDir)BepInEx\DumpedAssemblies\EscapeFromTarkov\Assembly-CSharp.dll"
      Private="false"
    />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ManagedDir)UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.VideoModule" HintPath="$(ManagedDir)UnityEngine.VideoModule.dll" Private="false" />
    <Reference Include="UnityEngine.DirectorModule" HintPath="$(ManagedDir)UnityEngine.DirectorModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ManagedDir)UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(ManagedDir)Comfort.dll" Private="false" />
    <Reference Include="Comfort.Unity" HintPath="$(ManagedDir)Comfort.Unity.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(TarkovDir)BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(TarkovDir)BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="spt-common" HintPath="$(TarkovDir)BepInEx\plugins\spt\spt-common.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="Resources\StoryMedia\**\*"
      CopyToOutputDirectory="PreserveNewest"
      TargetPath="StoryMedia\%(RecursiveDir)%(Filename)%(Extension)"
    />
    <None
      Include="Resources\seasonalperks_ui.bundle"
      CopyToOutputDirectory="PreserveNewest"
      TargetPath="seasonalperks_ui.bundle"
      Condition="Exists('Resources\seasonalperks_ui.bundle')"
    />
  </ItemGroup>
</Project>

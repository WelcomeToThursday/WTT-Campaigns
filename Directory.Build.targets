<Project>
  <!-- Evaluate after Build so output overrides and newly copied content are respected. -->
  <Target Name="GetCampaignsDeployFiles" DependsOnTargets="Build" Returns="@(CampaignsDeployFile)">
    <GetFileHash
      Files="$(TargetDir)WTT-Campaigns.Shared.dll"
      Condition="'$(MSBuildProjectName)' == 'WTT-Campaigns.UI' and '$(DeploymentScope)' == 'UI'"
    >
      <Output TaskParameter="Hash" PropertyName="_UISharedHash" />
    </GetFileHash>
    <VerifyFileHash File="$(CampaignsClientDir)WTT-Campaigns.Shared.dll" Hash="$(_UISharedHash)" Condition="'$(_UISharedHash)' != ''" />
    <VerifyFileHash File="$(CampaignsServerDir)WTT-Campaigns.Shared.dll" Hash="$(_UISharedHash)" Condition="'$(_UISharedHash)' != ''" />
    <PropertyGroup>
      <_CampaignsComponent Condition="'$(MSBuildProjectName)' == 'WTT-Campaigns.Server'">server</_CampaignsComponent>
      <_CampaignsComponent Condition="'$(MSBuildProjectName)' != 'WTT-Campaigns.Server'">client</_CampaignsComponent>
    </PropertyGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'WTT-Campaigns.UI' or '$(MSBuildProjectName)' == 'WTT-Campaigns.AI'">
      <_CampaignsRuntimeFile Include="$(TargetPath)" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'WTT-Campaigns.Client'">
      <_CampaignsRuntimeFile Include="$(TargetDir)ContainerLibrary\catalog.json;$(TargetDir)ContainerLibrary\native-containers.bundle" />
      <_CampaignsRuntimeFile Include="$(TargetPath);$(TargetDir)WTT-Campaigns.UI.dll;$(TargetDir)WTT-Campaigns.Shared.dll;$(TargetDir)wtt_campaigns_ui.bundle;$(TargetDir)wtt_campaigns_editor_toolkit.bundle;$(TargetDir)wtt_campaigns_story_notifications.bundle;$(TargetDir)StoryMedia\**\*" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'WTT-Campaigns.Server'">
      <_CampaignsRuntimeFile Include="$(TargetPath);$(TargetDir)WTT-Campaigns.Shared.dll;$(TargetDir)Markdig.dll;$(TargetDir)Newtonsoft.Json.dll;$(TargetDir)WTT-Campaigns.Server.deps.json;$(TargetDir)data\**\*;$(TargetDir)icons\**\*;$(TargetDir)hub-images\**\*;$(TargetDir)wwwroot\**\*" />
    </ItemGroup>
    <ItemGroup>
      <CampaignsDeployFile Include="@(_CampaignsRuntimeFile)">
        <InstallPath>$(_CampaignsComponent)\$([MSBuild]::MakeRelative('$(TargetDir)', '%(_CampaignsRuntimeFile.FullPath)'))</InstallPath>
      </CampaignsDeployFile>
    </ItemGroup>
  </Target>
</Project>

<Project DefaultTargets="Install">
  <Import Project="Directory.Build.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <DeploymentScope Condition="'$(DeploymentScope)' == ''">All</DeploymentScope>
    <AssetValidationPowerShell Condition="'$(AssetValidationPowerShell)' == '' and '$(OS)' == 'Windows_NT'">$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe</AssetValidationPowerShell>
    <AssetValidationPowerShell Condition="'$(AssetValidationPowerShell)' == ''">pwsh</AssetValidationPowerShell>
    <_BuildProperties>Configuration=$(Configuration)</_BuildProperties>
    <_NativeAssembly>$(TarkovDir)BepInEx\DumpedAssemblies\EscapeFromTarkov\Assembly-CSharp.dll</_NativeAssembly>
    <CampaignsPython Condition="'$(CampaignsPython)' == '' and Exists('$(MSBuildProjectDirectory)\.tools\Scripts\python.exe')">$(MSBuildProjectDirectory)\.tools\Scripts\python.exe</CampaignsPython>
    <CampaignsPython Condition="'$(CampaignsPython)' == ''">python</CampaignsPython>
  </PropertyGroup>
  <ItemGroup>
    <_DeployProject Include="Client\WTT-Campaigns.Client.csproj" Condition="'$(DeploymentScope)' == 'All' or '$(DeploymentScope)' == 'Client'" />
    <_DeployProject Include="Server\WTT-Campaigns.Server.csproj" Condition="'$(DeploymentScope)' == 'All' or '$(DeploymentScope)' == 'Server'" />
    <_DeployProject Include="UI\WTT-Campaigns.UI.csproj" Condition="'$(DeploymentScope)' == 'UI'" />
    <_TestProject Include="Tests\WTT-Campaigns.Tests.csproj" />
    <_WebTestProject Include="Tests.Web\WTT-Campaigns.Web.Tests.csproj" Condition="'$(DeploymentScope)' == 'All' or '$(DeploymentScope)' == 'Server'" />
  </ItemGroup>
  <Import Project="tools\Deployment.targets" />
  <Target Name="Build">
    <Error Condition="'@(_DeployProject)' == ''" Text="DeploymentScope must be All, Client, Server or UI." />
    <MSBuild Projects="@(_DeployProject);@(_TestProject);@(_WebTestProject)" Targets="Restore" Properties="$(_BuildProperties)" />
    <MSBuild Projects="@(_DeployProject)" Targets="GetCampaignsDeployFiles" Properties="$(_BuildProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="CampaignsDeployFile" />
    </MSBuild>
    <MSBuild Projects="@(_TestProject)" Targets="Build" Properties="$(_BuildProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="_TestAssembly" />
    </MSBuild>
    <MSBuild Projects="@(_WebTestProject)" Targets="Build" Properties="$(_BuildProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="_WebTestAssembly" />
    </MSBuild>
  </Target>
  <Target Name="Validate" DependsOnTargets="Build">
    <Error Condition="!Exists('$(_NativeAssembly)')" Text="Missing game reference: $(_NativeAssembly)" />
    <Exec Command="dotnet &quot;@(_TestAssembly)&quot; &quot;$(_NativeAssembly)&quot;" />
    <Exec Condition="'@(_WebTestAssembly)' != ''" Command="dotnet &quot;@(_WebTestAssembly)&quot;" />
    <Exec Condition="'$(DeploymentScope)' == 'All' or '$(DeploymentScope)' == 'Server'" Command="&quot;$(CampaignsPython)&quot; &quot;$(MSBuildProjectDirectory)\tools\test_quest_backports.py&quot;" />
    <CallTarget Targets="ValidateCapturedQuests" Condition="('$(DeploymentScope)' == 'All' or '$(DeploymentScope)' == 'Server') and Exists('$(MSBuildProjectDirectory)\..\1.0 Dump\gw-pve.escapefromtarkov.com\client\quest\list\response')" />
    <Exec Condition="'$(DeploymentScope)' == 'All' or '$(DeploymentScope)' == 'Server'" Command="dotnet &quot;@(_TestAssembly)&quot; --progression-data &quot;$(ServerDir)SPT_Data\database&quot;" />
    <Exec Condition="'$(DeploymentScope)' == 'All' or '$(DeploymentScope)' == 'Server'" Command="dotnet &quot;@(_TestAssembly)&quot; --appearance-data &quot;$(ServerDir)SPT_Data\database&quot;" />
    <ItemGroup>
      <_ClientAssembly Include="@(CampaignsDeployFile)" Condition="'%(Filename)%(Extension)' == 'WTT-Campaigns.Client.dll'" />
      <_ServerAssembly Include="@(CampaignsDeployFile)" Condition="'%(Filename)%(Extension)' == 'WTT-Campaigns.Server.dll'" />
      <_SharedAssembly Include="@(CampaignsDeployFile)" Condition="'%(Filename)%(Extension)' == 'WTT-Campaigns.Shared.dll'" />
    </ItemGroup>
    <Exec Condition="'@(_ServerAssembly)' != ''" Command="dotnet &quot;@(_TestAssembly)&quot; --editor-hooks &quot;$(ServerDir).&quot; &quot;@(_ServerAssembly)&quot;" />
    <Exec Condition="'@(_ClientAssembly)' != '' and '@(_ServerAssembly)' != ''" Command="dotnet &quot;@(_TestAssembly)&quot; --mod-identity &quot;@(_ClientAssembly)&quot; &quot;@(_ServerAssembly)&quot;" />
    <Exec Condition="'@(_ClientAssembly)' != '' and '@(_ServerAssembly)' != ''" Command="dotnet &quot;@(_TestAssembly)&quot; --authoring-socket &quot;$(TarkovDir).&quot; &quot;@(_ClientAssembly)&quot; &quot;@(_ServerAssembly)&quot;" />
    <Exec Condition="'@(_ClientAssembly)' != ''" Command="dotnet &quot;@(_TestAssembly)&quot; --ui &quot;$(_NativeAssembly)&quot; &quot;@(_ClientAssembly)&quot;" />
    <Exec Condition="'@(_ClientAssembly)' != ''" Command="dotnet &quot;@(_TestAssembly)&quot; --resource-hooks &quot;$(TarkovDir).&quot; &quot;@(_ClientAssembly)&quot;" />
    <Exec Condition="'@(_ClientAssembly)' != ''" Command="dotnet &quot;@(_TestAssembly)&quot; --bush-hooks &quot;$(TarkovDir).&quot; &quot;@(_ClientAssembly)&quot;" />
    <Exec Condition="'@(_ClientAssembly)' != ''" Command="dotnet &quot;@(_TestAssembly)&quot; --experience-hooks &quot;$(TarkovDir).&quot; &quot;@(_ClientAssembly)&quot;" />
    <Exec Condition="'@(_ClientAssembly)' != ''" Command="dotnet &quot;@(_TestAssembly)&quot; --unity-toolkit &quot;$(TarkovDir).&quot; &quot;@(_ClientAssembly)&quot;" />
    <Exec Condition="'@(_ClientAssembly)' != ''" Command="dotnet &quot;@(_TestAssembly)&quot; --raid-startup-hooks &quot;$(TarkovDir).&quot; &quot;@(_ClientAssembly)&quot;" />
    <GetFileHash Files="@(_SharedAssembly)" Condition="'$(DeploymentScope)' == 'Client' or '$(DeploymentScope)' == 'Server'">
      <Output TaskParameter="Hash" PropertyName="_SharedHash" />
    </GetFileHash>
    <VerifyFileHash File="$(CampaignsServerDir)WTT-Campaigns.Shared.dll" Hash="$(_SharedHash)" Condition="'$(DeploymentScope)' == 'Client'" />
    <VerifyFileHash File="$(CampaignsClientDir)WTT-Campaigns.Shared.dll" Hash="$(_SharedHash)" Condition="'$(DeploymentScope)' == 'Server'" />
    <Exec Command="&quot;$(AssetValidationPowerShell)&quot; -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)tools\validate_assets.ps1&quot; -ClientAssembly &quot;@(_ClientAssembly)&quot; -ServerAssembly &quot;@(_ServerAssembly)&quot;" Condition="'$(DeploymentScope)' != 'UI'" />
  </Target>
  <Target Name="ValidateCapturedQuests">
    <Exec Command="&quot;$(CampaignsPython)&quot; &quot;$(MSBuildProjectDirectory)\tools\import_quest_backports.py&quot; --check" />
    <Exec Command="&quot;$(CampaignsPython)&quot; &quot;$(MSBuildProjectDirectory)\tools\validate_trader_progression.py&quot;" />
  </Target>
  <Target Name="Install" DependsOnTargets="Validate;DeployCampaignsFiles" />
  <Target Name="Package" DependsOnTargets="Validate;StagePackage;DeployCampaignsFiles" />
  <Target Name="PackageDllHotfix" DependsOnTargets="Validate;StageDllHotfix;DeployCampaignsFiles" />
  <Target Name="StageDllHotfix">
    <Error Condition="'$(PackageDir)' == ''" Text="PackageDir is required for a DLL hotfix." />
    <ItemGroup>
      <_HotfixDll Include="@(CampaignsDeployFile)" Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(Filename)').StartsWith('WTT-Campaigns.'))">
        <PackagePath>$([System.String]::Copy('%(InstallPath)').Replace('client\', 'BepInEx\plugins\WTT-Campaigns\').Replace('server\', 'SPT_Runtime\user\mods\WTT-Campaigns\'))</PackagePath>
      </_HotfixDll>
      <CampaignsDeployFile Remove="@(CampaignsDeployFile)" />
      <CampaignsDeployFile Include="@(_HotfixDll)" />
    </ItemGroup>
    <GetFileHash Files="@(_HotfixDll)">
      <Output TaskParameter="Items" ItemName="_HashedHotfixDll" />
    </GetFileHash>
    <Copy SourceFiles="@(_HashedHotfixDll)" DestinationFiles="@(_HashedHotfixDll->'$(PackageDir)\%(PackagePath)')" />
    <VerifyFileHash File="$(PackageDir)\%(_HashedHotfixDll.PackagePath)" Hash="%(_HashedHotfixDll.FileHash)" />
    <Message Importance="high" Text="Staged and SHA-256 verified @(_HashedHotfixDll->Count()) project DLLs in $(PackageDir)." />
  </Target>
  <Target Name="StagePackage" DependsOnTargets="PrepareCampaignsFiles">
    <Error Condition="'$(PackageDir)' == ''" Text="PackageDir is required. Use tools/package.ps1 to choose a timestamped release directory." />
    <Copy SourceFiles="@(_PlannedFiles)" DestinationFiles="@(_PlannedFiles->'$(PackageDir)\%(PackagePath)')" />
    <ItemGroup>
      <_PackageDocument Include="README.md;RELEASE_NOTES.md;LICENSE;THIRD_PARTY_NOTICES.md;wiki\**\*" />
      <_PackageCopy Include="@(_PackageDocument)">
        <Destination>$(PackageDir)\$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '%(_PackageDocument.FullPath)'))</Destination>
      </_PackageCopy>
    </ItemGroup>
    <Copy SourceFiles="@(_PackageCopy)" DestinationFiles="@(_PackageCopy->'%(Destination)')" />
    <VerifyFileHash File="$(PackageDir)\%(_PlannedFiles.PackagePath)" Hash="%(_PlannedFiles.FileHash)" />
  </Target>
</Project>

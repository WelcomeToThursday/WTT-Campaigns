<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WTT.Campaigns.Shared</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Linq" />
    <Using Include="ZLinq" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Compile against the UnityToolkit baseline; each host supplies its own runtime DLL.
         Keep this private so Shared cannot upgrade or downgrade a host's dependency. -->
    <PackageReference Include="ZLinq" Version="1.5.3" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
</Project>
